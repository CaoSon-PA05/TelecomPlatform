APP_TITLE=Sentinel CDR Analytics API
APP_VERSION=0.1.0
ENV=development
DEBUG=true

DATABASE_URL=sqlite:///./telecom.db
DB_ECHO_SQL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

API_V1_PREFIX=/api/v1

CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000","http://127.0.0.1:3000"]

MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

LOG_LEVEL=INFO
LOG_FORMAT=text
