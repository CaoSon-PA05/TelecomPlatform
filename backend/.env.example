# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_TITLE=Sentinel CDR Analytics API
APP_VERSION=0.1.0
ENV=development          # development | testing | production
DEBUG=true

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
# SQLite (dev):
DATABASE_URL=sqlite:///./telecom.db

# PostgreSQL (prod):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/telecom_db

DB_ECHO_SQL=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ------------------------------------------------------------------
# API
# ------------------------------------------------------------------
API_V1_PREFIX=/api/v1

# ------------------------------------------------------------------
# CORS — comma-separated list of allowed origins
# ------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000"]

# ------------------------------------------------------------------
# File uploads
# ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=50
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO           # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=text          # text (dev) | json (prod)
