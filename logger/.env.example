# .env.production.example
# Sao chép file này thành .env và điền giá trị thật
# KHÔNG commit file .env lên git / repo công khai
#
# Sinh API_KEY ngẫu nhiên: python3 -c "import secrets; print(secrets.token_hex(32))"
# Sinh ADMIN_PASSWORD mạnh: python3 -c "import secrets; print(secrets.token_urlsafe(20))"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Mật khẩu đăng nhập trang /admin
# Tối thiểu 16 ký tự, bao gồm chữ hoa, số, ký tự đặc biệt
ADMIN_PASSWORD=THAY_BANG_MAT_KHAU_MANH_16_KY_TU_TRO_LEN

# API key cho TelecomPlatform SRAU module
# Phải khớp với giá trị trong srau-engine.js (SRAU_CONFIG.apiKey)
# 64 ký tự hex ngẫu nhiên
API_KEY=THAY_BANG_64_KY_TU_HEX_NGAU_NHIEN

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port Gunicorn lắng nghe (Nginx proxy đến đây)
# KHÔNG thay đổi trừ khi có lý do cụ thể
PORT=5000

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Đường dẫn tuyệt đối đến file SQLite
# Đảm bảo user iplogger có quyền đọc/ghi thư mục này
DB_PATH=/opt/iplogger/logger.db

# ---------------------------------------------------------------------------
# Flask
# ---------------------------------------------------------------------------

# Secret key cho Flask sessions (sinh bằng: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=THAY_BANG_SECRET_KEY_NGAU_NHIEN

# Giới hạn kích thước file upload (10 MB = 10 * 1024 * 1024)
# Phải khớp với client_max_body_size trong nginx.conf
MAX_CONTENT_LENGTH=10485760
